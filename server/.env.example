# --- Core ---
PORT=4000
PUBLIC_WEB_URL=http://localhost:5173
PUBLIC_API_URL=http://localhost:4000
JWT_SECRET=change-me-to-a-long-random-string
# 32-byte key, base64. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
APP_ENCRYPTION_KEY=
DATABASE_PATH=./slotwise.db
# Created/promoted to super admin when you run `npm run seed`
SUPERADMIN_EMAIL=you@example.com
SUPERADMIN_PASSWORD=change-me

# --- AI (optional; chat is disabled without it) ---
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5-5
AI_EFFORT=low

# --- Stripe (platform subscriptions + Stripe Connect for businesses) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- Square (businesses paste their own access token + location in admin) ---
SQUARE_ENV=sandbox
SQUARE_WEBHOOK_SIGNATURE_KEY=
SQUARE_WEBHOOK_URL=http://localhost:4000/api/webhooks/square

# --- PayPal (platform partner app; businesses supply merchant id) ---
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=

# --- SMS via Twilio (optional; without it texts are simulated and shown in the admin message log) ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Either a Messaging Service SID (recommended; handles STOP/HELP and US A2P 10DLC) or a from number.
TWILIO_MESSAGING_SERVICE_SID=
TWILIO_FROM_NUMBER=
# Country code assumed for numbers typed without one (1 = US/Canada)
SMS_DEFAULT_COUNTRY_CODE=1

# --- Email (password reset links). Set one; without it links are printed to the server log. ---
EMAIL_FROM=Slotwise <no-reply@yourdomain.com>
RESEND_API_KEY=
POSTMARK_SERVER_TOKEN=

# --- Sign in with Google (console.cloud.google.com → APIs & Services → Credentials → OAuth client ID, "Web application")
# Authorized redirect URI: <PUBLIC_API_URL>/api/auth/oauth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Sign in with Apple (developer.apple.com → Identifiers → Services IDs; Keys → "Sign in with Apple")
# Return URL: <PUBLIC_API_URL>/api/auth/oauth/apple/callback  (must be HTTPS; not localhost)
APPLE_SERVICES_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
# Paste the .p8 file contents; newlines may be written as \n
APPLE_PRIVATE_KEY=

# --- Calendar sync. Google reuses GOOGLE_CLIENT_ID/SECRET above (enable the Google Calendar API and add
# redirect URI <PUBLIC_API_URL>/api/integrations/google/callback). Outlook needs an Azure app registration:
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
# Second Stripe webhook endpoint ("Events on connected accounts") has its own signing secret:
STRIPE_CONNECT_WEBHOOK_SECRET=
